# Copy this file to .env.local and fill in the values. Both are optional when running on your own computer.

# The password for logging in to the app. Required on Vercel.
APP_PASSWORD=

# On Vercel, adding the Upstash Redis integration sets these for you.
# Without them the app saves to data/store.json on your computer.
KV_REST_API_URL=
KV_REST_API_TOKEN=
