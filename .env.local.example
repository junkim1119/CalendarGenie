# Copy this file to .env.local and fill in the values.

# From https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional locally, required on Vercel: the password for logging in to the app.
APP_PASSWORD=

# Optional locally. On Vercel, adding the Upstash Redis integration sets these for you.
# Without them the app saves to data/store.json on your computer.
KV_REST_API_URL=
KV_REST_API_TOKEN=
